    {
      "parameters": {
        "jsCode": "const data = $('Edit Fields').first().json;\n\nconst date = data[\"Preferred Date\"];   // YYYY-MM-DD\nconst time = data[\"Preferred Time\"];    // HH:mm\n\nconst [y, mo, d] = date.split(\"-\").map(Number);\nconst [h, mi] = time.split(\":\").map(Number);\n\n// Build base as UTC so arithmetic is deterministic and wall-clock is preserved\nconst baseMs = Date.UTC(y, mo - 1, d, h, mi, 0);\nconst HOUR = 60 * 60 * 1000;\n\nconst pad = (n) => String(n).padStart(2, \"0\");\nconst fmt = (ms) => {\n  const dt = new Date(ms);\n  return dt.getUTCFullYear() + \"-\" + pad(dt.getUTCMonth() + 1) + \"-\" + pad(dt.getUTCDate()) +\n    \"T\" + pad(dt.getUTCHours()) + \":\" + pad(dt.getUTCMinutes()) + \":00\";\n};\n\nconst offsets = [1 * HOUR, 2 * HOUR, 24 * HOUR];\n\nreturn offsets.map((off, i) => {\n  const startMs = baseMs + off;\n  const endMs = startMs + HOUR;\n  return {\n    json: {\n      Name: data[\"Name\"],\n      email: data[\"email\"],\n      Service: data[\"Service\"],\n      alternativeNumber: i + 1,\n      alternativeStart: fmt(startMs),\n      alternativeEnd: fmt(endMs)\n    }\n  };\n});"
      },
