    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst first = items[0].json;\n\nconst pretty = (iso) => {\n  // iso like YYYY-MM-DDTHH:mm:00\n  const [datePart, timePart] = iso.split(\"T\");\n  const hm = timePart.slice(0, 5);\n  return datePart + \" at \" + hm;\n};\n\nconst lines = items.map((it, i) => {\n  return (i + 1) + \". \" + pretty(it.json.alternativeStart) + \" - \" + pretty(it.json.alternativeEnd);\n});\n\nconst slotsText = lines.join(\"\\n\");\n\nreturn [{\n  json: {\n    Name: first.Name,\n    email: first.email,\n    Service: first.Service,\n    slotsText: slotsText\n  }\n}];"
      },
